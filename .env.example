# The Residentialist Mission Control Configuration
# Copy this to .env and fill in your values

# IMAP Email Configuration
EMAIL_ADDRESS=danvandertel@gmail.com
EMAIL_PASSWORD=your-app-password
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
EMAIL_FOLDER=INBOX

# OpenClaw
OPENCLAW_WORKSPACE=/home/ubuntu/.openclaw/workspace

# Database
DATABASE_PATH=./residentialist.db

# Telegram Integration
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
TELEGRAM_CHAT_ID=your-chat-id

# Airtable (setup later)
AIRTABLE_API_KEY=your-api-key
AIRTABLE_BASE_ID=your-base-id
AIRTABLE_PRODUCTS_TABLE=Products
AIRTABLE_PROPERTIES_TABLE=Properties
AIRTABLE_BUILDERS_TABLE=Builders
AIRTABLE_INSTALLATIONS_TABLE=Product Installations
AIRTABLE_EVALUATIONS_TABLE=Evaluation Log
AIRTABLE_OUTREACH_TABLE=Outreach Log

# Bot Configuration
BOT1_MODEL=anthropic/claude-haiku-4-5-20251001
BOT2_MODEL=anthropic/claude-haiku-4-5-20251001
BOT3_MODEL=anthropic/claude-haiku-4-5-20251001

# Dashboard
DASHBOARD_PORT=3000
DASHBOARD_HOST=localhost

# Windows Category Files
WINDOWS_EVAL_KNOWLEDGE=/home/ubuntu/.openclaw/workspace/residentialist/windows/windows_eval_knowledge_v1.1.md
WINDOWS_MATERIAL_SAFETY=/home/ubuntu/.openclaw/workspace/residentialist/windows/windows_material_safety_knowledge_v1.1.md
WINDOWS_RUBRICS=/home/ubuntu/.openclaw/workspace/residentialist/windows/windows_deterministic_rubrics_v5.md
UNIVERSAL_PRINCIPLES=/home/ubuntu/.openclaw/workspace/residentialist/windows/residentialist_universal_rubric_principles_v1.1.md
WINDOWS_PACKET=/home/ubuntu/.openclaw/workspace/residentialist/windows/henley_windows_packet_v1.1.md
